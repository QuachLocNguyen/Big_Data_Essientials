# =====================================================================
# BÀI 2 (SLAVE 1): WORD MEAN BẰNG PYSPARK MAPREDUCE
# Sinh viên thực hiện: Nguyễn Đức Học - 24162039 (hoc-slave1)
# Mục tiêu: Tính độ dài trung bình của các từ trong văn bản (Word Mean)
# =====================================================================

from pyspark.sql import SparkSession

spark = (
    SparkSession.builder
    .appName("WordMean_CustomerReview")
    .enableHiveSupport()
    .getOrCreate()
)

try:
    reviews = spark.sql("""
        SELECT customer_review
        FROM ecommerce_dw.staging_orders
        WHERE customer_review IS NOT NULL
          AND TRIM(customer_review) <> ''
    """)

    # Tách từ theo khoảng trắng, giống cách tính Word Mean mẫu
    words = reviews.rdd.flatMap(
        lambda row: row["customer_review"].split()
    )

    # Cộng tổng số ký tự và tổng số từ
    total_chars, total_words = words.map(
        lambda word: (len(word), 1)
    ).fold(
        (0, 0),
        lambda a, b: (a[0] + b[0], a[1] + b[1])
    )

    print("===== WORD MEAN: CUSTOMER REVIEW =====")
    print(f"Tổng số từ: {total_words}")

    if total_words:
        print(f"Tổng số ký tự: {total_chars}")
        print(f"Word Mean: {total_chars / total_words:.4f}")
    else:
        print("Không tìm thấy từ nào trong customer_review.")

finally:
    spark.stop()

